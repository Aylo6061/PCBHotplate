#!/usr/bin/env bash
# HeaterApp launcher. Idempotent: creates the venv and installs dependencies
# on first run (or when requirements.txt changes), then starts the app.
# Works from Git Bash on Windows, macOS Terminal and Linux.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

VENV=".venv"
MARKER="$VENV/.deps-ok"

# ---------------------------------------------------------------- python
find_python() {
    local candidates=("python3" "python" "py -3")
    for c in "${candidates[@]}"; do
        if $c -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

if ! PY="$(find_python)"; then
    cat >&2 <<'EOF'
ERROR: Python 3.10 or newer was not found on PATH.

Manual install required:
  Windows : https://www.python.org/downloads/windows/  (tick "Add python.exe to PATH")
            or:  winget install Python.Python.3.12
  macOS   : brew install python@3.12        (https://brew.sh)
            or the installer from https://www.python.org/downloads/macos/
  Linux   : sudo apt install python3 python3-venv     (Debian/Ubuntu)
            sudo dnf install python3                  (Fedora)

Then re-run ./run
EOF
    exit 1
fi

# ---------------------------------------------------------------- venv
if [ -x "$VENV/Scripts/python.exe" ]; then
    VPY="$VENV/Scripts/python.exe"
elif [ -x "$VENV/bin/python" ]; then
    VPY="$VENV/bin/python"
else
    echo "Creating virtual environment in $VENV ..."
    if ! $PY -m venv "$VENV"; then
        cat >&2 <<'EOF'
ERROR: could not create a virtual environment.
  Debian/Ubuntu: sudo apt install python3-venv
EOF
        exit 1
    fi
    if [ -x "$VENV/Scripts/python.exe" ]; then VPY="$VENV/Scripts/python.exe"; else VPY="$VENV/bin/python"; fi
fi

# ---------------------------------------------------------------- deps
if [ ! -f "$MARKER" ] || [ "requirements.txt" -nt "$MARKER" ]; then
    echo "Installing dependencies ..."
    "$VPY" -m pip install --upgrade pip >/dev/null
    if ! "$VPY" -m pip install -r requirements.txt; then
        cat >&2 <<'EOF'
ERROR: dependency installation failed.
  PySide6 needs a 64-bit Python 3.10+ and, on Linux, the system libraries:
    sudo apt install libgl1 libegl1 libxkbcommon0 libdbus-1-3 libfontconfig1 libxcb-cursor0
  Then re-run ./run
EOF
        exit 1
    fi
    touch "$MARKER"
fi

# ---------------------------------------------------------------- run
exec "$VPY" -m heaterapp "$@"
